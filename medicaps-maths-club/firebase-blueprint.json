{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered club members",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["member", "admin"] }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    }
  }
}
